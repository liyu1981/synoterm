#!/bin/sh
# Runs after the package payload has been installed.
# The package user exists by now, so we can create its writable layout.
set -eu

VAR="${SYNOPKG_PKGVAR}"
mkdir -p "${VAR}/home" "${VAR}/runtime" "${VAR}/etc"
chmod 700 "${VAR}/home" "${VAR}/runtime"

# Never overwrite an existing config on upgrade.
if [ ! -f "${VAR}/etc/synoterm.conf" ]; then
  cat >"${VAR}/etc/synoterm.conf" <<'CONF'
# synoterm service settings (read by start-stop-status).
#
# Group a DSM account must belong to in order to open a terminal.
# Set to an empty string to allow every authenticated local DSM account.
REQUIRE_GROUP="administrators"
#
# Concurrent terminal limit across all users.
MAX_SESSIONS="8"
#
# Listen address of the backend:
#   auto      loopback when the nginx mount from contrib/ is installed, otherwise
#             0.0.0.0 so the DSM-served page can reach it from your browser
#   127.0.0.1 only loopback (the mount or a reverse proxy must be in place)
#   0.0.0.0   always reachable on the LAN (still requires a DSM login)
BIND="auto"
#
# Extra flags appended to the command line, e.g.:
# EXTRA_ARGS="--idle-timeout 3600"
EXTRA_ARGS=""
CONF
  chmod 600 "${VAR}/etc/synoterm.conf"
fi
exit 0
